#!/usr/bin/env bash
# verify-smile: drive the SMILE factory against a throwaway fixture repo and keep the proof.
#
#   verify-smile up                                   create a fixture, print "fixture ready <runid> <path>"
#   verify-smile feature <name> [--real-review] [--backend <b>] [--run <runid>]
#   verify-smile down <runid>                         collect evidence, tear the fixture down
#   verify-smile list                                 known runs and their state
#   verify-smile gc [--dry-run]                       delete leftover smile-verify-*-trash repos
#
# A run is one manifest at ~/.smile-verify/<runid>/manifest.json. Every command reads or writes
# that manifest and nothing else, so any later agent can pick a run up cold. `up` writes the
# manifest before its first side effect and after each one, so a failed `up` can always be
# torn down from what the manifest records.
set -Eeuo pipefail

EVIDENCE_ROOT="${SMILE_VERIFY_ROOT:-$HOME/.smile-verify}"
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
SMILE_REPO=$(cd "$SCRIPT_DIR/../../../.." && pwd)

die() { printf 'verify-smile: %s\n' "$*" >&2; exit 1; }
log() { printf '[verify-smile] %s\n' "$*"; }

manifest_path() { printf '%s/%s/manifest.json' "$EVIDENCE_ROOT" "$1"; }

# mf <runid> <key>: print one manifest field, empty when absent
mf() {
	python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2], ""))' \
		"$(manifest_path "$1")" "$2"
}

# mf_set <runid> key value [key value ...]: merge fields into the manifest, creating it if needed.
# Values travel as argv, never as interpolated source.
mf_set() {
	local runid="$1"; shift
	mkdir -p "$EVIDENCE_ROOT/$runid"
	python3 - "$(manifest_path "$runid")" "$@" <<'EOF'
import json, os, sys
path = sys.argv[1]
m = json.load(open(path)) if os.path.exists(path) else {}
args = sys.argv[2:]
for k, v in zip(args[0::2], args[1::2]):
    m[k] = v
tmp = path + ".tmp"
json.dump(m, open(tmp, "w"), indent=2)
os.replace(tmp, path)
EOF
}

require_manifest() {
	[ -f "$(manifest_path "$1")" ] || die "no manifest for run '$1' under $EVIDENCE_ROOT; refusing"
}

each_run() {   # runids in creation order
	local m
	for m in "$EVIDENCE_ROOT"/*/manifest.json; do
		[ -f "$m" ] || continue
		basename "$(dirname "$m")"
	done
}

latest_run() { each_run | tail -1; }

# fail_hook <stage>: test hook. When SMILE_VERIFY_FAIL_AFTER names this stage, fail here.
fail_hook() {
	if [ "${SMILE_VERIFY_FAIL_AFTER:-}" = "$1" ]; then
		log "forced failure after stage '$1' (SMILE_VERIFY_FAIL_AFTER)"
		return 1
	fi
	return 0
}

# ---------------------------------------------------------------- up
up_failed() {
	local runid="$1"
	trap - ERR
	log "up failed; tearing down run $runid from its manifest"
	cmd_down "$runid" || log "teardown of $runid also failed; rerun: verify-smile down $runid"
	exit 1
}

cmd_up() {
	command -v gh >/dev/null || die "gh missing"
	command -v bd >/dev/null || die "bd missing"
	command -v tmux >/dev/null || die "tmux missing"
	command -v git >/dev/null || die "git missing"
	gh auth status >/dev/null 2>&1 || die "gh is not logged in"

	local runid owner name tmp fixture session smile_commit
	runid="$(date -u +%Y%m%dT%H%M%SZ)-$(head -c 2 /dev/urandom | od -An -tx1 | tr -d ' \n')"
	owner=$(gh api user --jq .login)
	name="smile-verify-$runid"
	session="smile-verify-$runid"
	tmp=$(mktemp -d "${TMPDIR:-/tmp}/smile-verify.XXXXXX")
	fixture="$tmp/$name"
	smile_commit=$(git -C "$SMILE_REPO" rev-parse --short HEAD 2>/dev/null || echo unknown)

	mf_set "$runid" runid "$runid" owner "$owner" repo "$owner/$name" repo_name "$name" \
		fixture "$fixture" tmp "$tmp" tmux_session "$session" \
		smile_repo "$SMILE_REPO" smile_commit "$smile_commit" state creating stage names
	log "run $runid"
	trap 'up_failed "$runid"' ERR
	fail_hook names

	log "creating private repo $owner/$name"
	(cd "$tmp" && gh repo create "$name" --private --clone >/dev/null 2>&1)
	mf_set "$runid" stage repo
	fail_hook repo
	[ -d "$fixture/.git" ]
	mf_set "$runid" stage clone
	fail_hook clone

	(
		cd "$fixture"
		git config user.email "verify-smile@localhost"
		git config user.name "verify-smile"
		printf '# %s\n\nSMILE verification fixture. Safe to delete.\n' "$name" > README.md
		git add README.md
		git commit -q -m "chore: fixture init"
		git branch -M main
		git push -q -u origin main
	)
	mf_set "$runid" stage init
	fail_hook init

	log "seeding beads"
	local bead_a bead_b ready_ids
	(cd "$fixture" && BD_NON_INTERACTIVE=1 bd init --prefix sv >/dev/null 2>&1)
	bead_a=$(cd "$fixture" && bd create "bead A: add a file" --silent)
	bead_b=$(cd "$fixture" && bd create "bead B: add a second file, after A" --deps "$bead_a" --silent)
	ready_ids=$(cd "$fixture" && bd ready --json | python3 -c 'import json,sys; print(" ".join(i["id"] for i in json.load(sys.stdin)))')
	[ "$ready_ids" = "$bead_a" ]
	mf_set "$runid" bead_a "$bead_a" bead_b "$bead_b" stage beads
	fail_hook beads

	log "opening tmux session $session"
	tmux new-session -d -s "$session" -c "$fixture"
	mf_set "$runid" stage tmux
	fail_hook tmux

	local install_result
	if [ -f "$SMILE_REPO/install.py" ]; then
		log "stamping SMILE from $SMILE_REPO@$smile_commit"
		if uv run "$SMILE_REPO/install.py" "$fixture" > "$EVIDENCE_ROOT/$runid/install-stamp.log" 2>&1; then
			install_result="stamped"
			# commit the stamp as a user would; bd init already committed .gitignore, and an
			# unstaged edit to it makes the stub worker's pull --rebase refuse
			(cd "$fixture" && git add -A && git commit -q -m "chore: stamp smile" && git push -q origin main)
			mf_set "$runid" stamp_commit "$(git -C "$fixture" rev-parse HEAD)"
		else
			install_result="stamp-failed"
			log "install.py failed, see $EVIDENCE_ROOT/$runid/install-stamp.log"
		fi
	else
		install_result="skipped"
		log "install skipped, no install.py yet"
	fi
	mf_set "$runid" install "$install_result" stage stamp state up
	fail_hook stamp
	trap - ERR
	printf 'fixture ready %s %s\n' "$runid" "$fixture"
}

# ---------------------------------------------------------------- feature
need_value() { [ -n "${2:-}" ] || die "flag $1 needs a value"; }

cmd_feature() {
	local name="${1:-}"; shift || true
	[ -n "$name" ] || die "usage: verify-smile feature <name> [--real-review] [--backend <b>] [--run <runid>]"
	local real_review=0 backend="" runid=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--real-review) real_review=1 ;;
			--backend) need_value "$1" "${2:-}"; backend="$2"; shift ;;
			--run) need_value "$1" "${2:-}"; runid="$2"; shift ;;
			*) die "unknown flag $1" ;;
		esac
		shift
	done
	[ -n "$runid" ] || runid=$(latest_run)
	[ -n "$runid" ] || die "no run found; run 'verify-smile up' first"
	require_manifest "$runid"
	[ "$(mf "$runid" state)" = "up" ] || die "run $runid is not up (state $(mf "$runid" state))"
	local fixture logf
	fixture=$(mf "$runid" fixture)
	logf="$EVIDENCE_ROOT/$runid/$name.log"
	{
		printf '=== feature %s real_review=%s backend=%s run=%s at %s\n' \
			"$name" "$real_review" "${backend:-default}" "$runid" "$(date -u +%FT%TZ)"
		case "$name" in
			install) feature_install "$runid" "$fixture" ;;
			doctor) feature_doctor "$runid" "$fixture" ;;
			mux) feature_mux "$runid" "$fixture" "$backend" ;;
			loop) feature_loop "$runid" "$fixture" ;;
			review) feature_review "$runid" "$fixture" "$real_review" ;;
			gate) feature_gate "$runid" "$fixture" ;;
			watchtower|narrate)
				printf 'NOT IMPLEMENTED %s (lands in a later spike)\n' "$name"
				exit 2 ;;
			*) die "unknown feature '$name'; see features/README.md" ;;
		esac
	} 2>&1 | tee -a "$logf"
}

feature_install() {
	local runid="$1" fixture="$2"
	local install
	install=$(mf "$runid" install)
	[ -d "$fixture/.beads" ] || { printf 'FAIL install: no .beads in fixture\n'; return 1; }
	tmux has-session -t "=$(mf "$runid" tmux_session)" 2>/dev/null \
		|| { printf 'FAIL install: tmux session missing\n'; return 1; }
	case "$install" in
		skipped)
			printf 'PASS install (stamp skipped, nothing stamped yet)\n' ;;
		stamped)
			[ -x "$fixture/smile/smile" ] || { printf 'FAIL install: smile/smile not stamped or not executable\n'; return 1; }
			[ -f "$fixture/smile.config.yaml" ] || { printf 'FAIL install: smile.config.yaml missing\n'; return 1; }
			printf 'PASS install (stamped)\n' ;;
		*)
			printf 'FAIL install: stamp result %s\n' "$install"; return 1 ;;
	esac
}

# feature_doctor: run `smile doctor` in the fixture and assert exit 0 with exactly seven `ok `
# lines. The transcript goes to the feature log through the caller's tee.
feature_doctor() {
	local runid="$1" fixture="$2" out rc=0
	[ "$(mf "$runid" install)" = "stamped" ] || { printf 'FAIL doctor: fixture not stamped (install=%s)\n' "$(mf "$runid" install)"; return 1; }
	out=$("$fixture/smile/smile" doctor) || rc=$?
	printf '%s\n--- exit %s\n' "$out" "$rc"
	[ "$rc" -eq 0 ] || { printf 'FAIL doctor: exit %s\n' "$rc"; return 1; }
	[ "$(printf '%s\n' "$out" | wc -l | tr -d ' ')" -eq 7 ] || { printf 'FAIL doctor: expected seven lines\n'; return 1; }
	[ "$(printf '%s\n' "$out" | grep -c '^ok ')" -eq 7 ] || { printf 'FAIL doctor: a line is not ok\n'; return 1; }
	printf 'PASS doctor\n'
}

# feature_mux: drive the three verbs of `smile mux` against the fixture's own tmux session.
# Spawns three panes, asserts the window count rose by three and each handle is alive, kills them,
# asserts each is dead and the count is back, then kills one twice to prove kill is idempotent.
# Only handles this run spawned are ever killed; the session belongs to the fixture.
feature_mux() {
	local runid="$1" fixture="$2" backend="$3"
	local smile session before after rc=0 h handles=""
	[ "$(mf "$runid" install)" = "stamped" ] || { printf 'FAIL mux: fixture not stamped (install=%s)\n' "$(mf "$runid" install)"; return 1; }
	smile="$fixture/smile/smile"
	[ -x "$smile" ] || { printf 'FAIL mux: %s is not executable\n' "$smile"; return 1; }
	[ -f "$fixture/smile/py/backends/tmux.py" ] || { printf 'NOT IMPLEMENTED mux (no smile/py/backends/tmux.py stamped)\n'; exit 2; }

	# The backend key is written on every run, empty when --backend is absent, so a value a
	# previous feature run left behind cannot decide this one.
	case "$backend" in
		''|tmux|cmux|herdr|screen) ;;
		*) printf 'FAIL mux: --backend %s is not a backend name\n' "$backend"; return 1 ;;
	esac
	sed -i.bak "s/^backend:.*/backend: $backend/" "$fixture/smile.config.yaml"
	rm -f "$fixture/smile.config.yaml.bak"
	git -C "$fixture" diff --quiet || git -C "$fixture" commit -qam "chore: backend ${backend:-auto}"

	# The fixture's own session, so nothing of the user's is ever touched.
	session=$(mf "$runid" tmux_session)
	tmux has-session -t "=$session" 2>/dev/null || { printf 'FAIL mux: tmux session %s missing\n' "$session"; return 1; }
	export SMILE_MUX_SESSION="$session"
	before=$(tmux list-windows -t "=$session" -F '#{window_id}' | wc -l | tr -d ' ')
	printf 'windows before: %s\n' "$before"
	tmux list-windows -t "=$session"

	local n
	for n in w1 w2 w3; do
		h=$("$smile" mux spawn "$n" "$fixture" sleep 300) || { printf 'FAIL mux: spawn %s exited %s\n' "$n" "$?"; return 1; }
		printf 'spawned %s -> %s\n' "$n" "$h"
		case "$h" in tmux:*|cmux:*|herdr:*) ;; *) printf 'FAIL mux: handle %s does not start with a backend name\n' "$h"; return 1 ;; esac
		handles="$handles $h"
	done

	after=$(tmux list-windows -t "=$session" -F '#{window_id}' | wc -l | tr -d ' ')
	printf 'windows after spawn: %s\n' "$after"
	tmux list-windows -t "=$session"
	[ "$after" -eq $((before + 3)) ] || { printf 'FAIL mux: expected %s windows, found %s\n' "$((before + 3))" "$after"; return 1; }

	for h in $handles; do
		"$smile" mux alive "$h" || { printf 'FAIL mux: alive %s exited %s, want 0\n' "$h" "$?"; return 1; }
	done
	printf 'all three alive\n'

	for h in $handles; do
		"$smile" mux kill "$h" || { printf 'FAIL mux: kill %s exited %s, want 0\n' "$h" "$?"; return 1; }
	done
	for h in $handles; do
		rc=0; "$smile" mux alive "$h" || rc=$?
		[ "$rc" -eq 1 ] || { printf 'FAIL mux: alive %s after kill exited %s, want 1\n' "$h" "$rc"; return 1; }
	done
	after=$(tmux list-windows -t "=$session" -F '#{window_id}' | wc -l | tr -d ' ')
	printf 'windows after kill: %s\n' "$after"
	tmux list-windows -t "=$session"
	[ "$after" -eq "$before" ] || { printf 'FAIL mux: expected %s windows after kill, found %s\n' "$before" "$after"; return 1; }

	h=${handles##* }
	"$smile" mux kill "$h" || { printf 'FAIL mux: second kill of %s exited %s, want 0\n' "$h" "$?"; return 1; }
	printf 'second kill of %s exited 0\n' "$h"
	printf 'PASS mux\n'
}

# ---------------------------------------------------------------- the run's scratch world
# world_up <runid> <fixture>: build the scratch HOME, the git config, and the stub wrappers that
# every driven feature runs in, and set the WORLD_* variables `drive` reads. One place decides what
# "the same world" is, because the driver, its worker panes, and its `smile review` subprocess must
# all be in it.
#
# HOME points at the run's evidence directory: the driver writes the trust flag into ~/.claude.json
# and treehouse pools its worktrees under $HOME. gh and git keep the real config through
# GH_CONFIG_DIR and GIT_CONFIG_GLOBAL, plus GIT_CONFIG_NOSYSTEM=1, because the Xcode command-line
# tools put `credential.helper = osxkeychain` in the SYSTEM config, and a scratch home has no login
# keychain. GH_TOKEN answers the gh credential helper; it is read here, while HOME is still the real
# one, and never written to disk.
world_up() {
	local runid="$1" fixture="$2" git_name git_email
	WORLD_SMILE="$fixture/smile/smile"
	WORLD_SESSION=$(mf "$runid" tmux_session)
	tmux has-session -t "=$WORLD_SESSION" 2>/dev/null \
		|| { printf 'FAIL: tmux session %s missing\n' "$WORLD_SESSION"; return 1; }
	WORLD_HOME="$EVIDENCE_ROOT/$runid/home"
	WORLD_GH_CFG="${GH_CONFIG_DIR:-$HOME/.config/gh}"
	WORLD_GIT_CFG="$WORLD_HOME/gitconfig"
	WORLD_TOKEN=$(gh auth token 2>/dev/null) || { printf 'FAIL: gh has no token for this account\n'; return 1; }
	git_name=$(git config --global --get user.name 2>/dev/null || true)
	git_email=$(git config --global --get user.email 2>/dev/null || true)
	mkdir -p "$WORLD_HOME"
	printf '[credential]\n\thelper = !gh auth git-credential\n[user]\n\tname = %s\n\temail = %s\n' \
		"$git_name" "$git_email" > "$WORLD_GIT_CFG"
	world_wrapper "$WORLD_HOME/worker-env" "$SCRIPT_DIR/stub-worker"
	world_wrapper "$WORLD_HOME/reviewer-env" "$SCRIPT_DIR/stub-reviewer"
	WORLD_WORKER="$WORLD_HOME/worker-env"
	WORLD_REVIEW_CMD="$WORLD_HOME/reviewer-env"
	WORLD_CHANGES_ONCE="${WORLD_CHANGES_ONCE:-0}"
	WORLD_LOG="$fixture/.factory/events.jsonl"
}

# world_wrapper <path> <target>: a wrapper that re-enters the scratch world and execs the stub. A
# pane inherits the multiplexer session's environment, not the driver's, and `smile review` hands
# the reviewer its own environment, so both stubs are entered through one of these.
world_wrapper() {
	cat > "$1" <<WRAPEOF
#!/bin/sh
export HOME="$WORLD_HOME" GIT_CONFIG_GLOBAL="$WORLD_GIT_CFG" GIT_CONFIG_NOSYSTEM=1
export GH_CONFIG_DIR="$WORLD_GH_CFG" GH_TOKEN="$WORLD_TOKEN"
exec "$2" "\$@"
WRAPEOF
	chmod +x "$1"
}

# drive <args...>: the fixture's own smile, in that world. WORLD_REVIEW_CMD empty means the real
# headless reviewer, which is what --real-review asks for.
drive() {
	env HOME="$WORLD_HOME" GH_CONFIG_DIR="$WORLD_GH_CFG" GIT_CONFIG_GLOBAL="$WORLD_GIT_CFG" \
		GH_TOKEN="$WORLD_TOKEN" GIT_CONFIG_NOSYSTEM=1 SMILE_MUX_SESSION="$WORLD_SESSION" \
		SMILE_WORKER_CMD="$WORLD_WORKER" SMILE_REVIEW_CMD="$WORLD_REVIEW_CMD" \
		SMILE_STUB_CHANGES_ONCE="$WORLD_CHANGES_ONCE" \
		"$WORLD_SMILE" "$@"
}

# world_events <bead> <event>: how many such events the log holds for that bead
world_events() {
	python3 -c '
import json, sys
print(sum(1 for o in map(json.loads, open(sys.argv[1])) if o["bead"] == sys.argv[2] and o["event"] == sys.argv[3]))' \
		"$WORLD_LOG" "$1" "$2" 2>/dev/null || printf '0\n'
}

# world_sequence <bead>: that bead's event names, oldest first, space separated
world_sequence() {
	python3 -c '
import json, sys
print(" ".join(o["event"] for o in map(json.loads, open(sys.argv[1])) if o["bead"] == sys.argv[2]))' \
		"$WORLD_LOG" "$1" 2>/dev/null || printf '\n'
}

# world_pr <bead>: the number of the pull request carrying that bead's trailer, any state
world_pr() {
	(cd "$2" && gh pr list --state all --limit 50 --json number,body) | python3 -c '
import json, sys
for pr in sorted(json.load(sys.stdin), key=lambda p: p["number"]):
    if "Bead: " + sys.argv[1] in [l.strip() for l in pr["body"].splitlines()]:
        print(pr["number"])
        break' "$1"
}

# world_tick_until <seconds> <fixture> <check...>: tick the driver until the check passes or time is
# up. A tick that exits non-zero is printed and the loop goes on: the next tick re-reads the world.
world_tick_until() {
	local cap="$1" fixture="$2"; shift 2
	local deadline=$(( $(date +%s) + cap )) n=0 rc=0
	while [ "$(date +%s)" -lt "$deadline" ]; do
		n=$((n + 1))
		rc=0
		drive run --once || rc=$?
		[ "$rc" -eq 0 ] || printf 'tick %s exited %s\n' "$n" "$rc"
		if "$@"; then
			printf 'condition met after %s tick(s)\n' "$n"
			return 0
		fi
		sleep 10
	done
	printf 'gave up after %s tick(s) and %ss\n' "$n" "$cap"
	return 1
}

# feature_loop: drive the driver through one claim tick and one reap tick with the stub worker.
# S3 scope: claim, worktree, pane, the workers' PRs, then reap and campaign.complete. The review
# lane, the merges, and the bead closes the driver does itself land in S4; here the feature closes
# the beads with `bd close` to stand in for them.
#
# The driver runs with HOME pointed at the run's evidence directory, because it writes the trust
# flag into ~/.claude.json and treehouse pools its worktrees under $HOME; gh and git keep the real
# config through GH_CONFIG_DIR and GIT_CONFIG_GLOBAL, so the fixture repo is still reachable.
feature_loop() {
	local runid="$1" fixture="$2"
	local smile log bead_a bead_b bead_c ready
	[ "$(mf "$runid" install)" = "stamped" ] || { printf 'FAIL loop: fixture not stamped (install=%s)\n' "$(mf "$runid" install)"; return 1; }
	smile="$fixture/smile/smile"
	[ -f "$fixture/smile/py/run.py" ] || { printf 'NOT IMPLEMENTED loop (no smile/py/run.py stamped)\n'; exit 2; }

	# `up` seeds bd itself; the driver also needs the treehouse pool and .factory, which is what a
	# user gets from `smile init`. It is idempotent, so a fixture already initialized is untouched.
	"$smile" init || { printf 'FAIL loop: smile init exited %s\n' "$?"; return 1; }
	git -C "$fixture" add -A
	git -C "$fixture" diff --cached --quiet || git -C "$fixture" commit -qm "chore: smile init"

	world_up "$runid" "$fixture" || return 1
	log="$WORLD_LOG"

	# bead A is ready and bead B is blocked by it, so one more independent bead gives the tick
	# exactly two claimable beads.
	bead_a=$(mf "$runid" bead_a)
	bead_b=$(mf "$runid" bead_b)
	bead_c=$(mf "$runid" bead_c)
	if [ -z "$bead_c" ]; then
		bead_c=$(cd "$fixture" && BD_NON_INTERACTIVE=1 bd create "bead C: add a third file" --silent)
		mf_set "$runid" bead_c "$bead_c"
	fi
	ready=$(cd "$fixture" && BD_NON_INTERACTIVE=1 bd ready --json | python3 -c 'import json,sys; print(" ".join(sorted(i["id"] for i in json.load(sys.stdin))))')
	printf 'beads: a=%s b=%s c=%s ready=[%s]\n' "$bead_a" "$bead_b" "$bead_c" "$ready"
	[ "$ready" = "$(printf '%s\n%s\n' "$bead_a" "$bead_c" | sort | tr '\n' ' ' | sed 's/ $//')" ] \
		|| { printf 'FAIL loop: expected A and C ready, got [%s]\n' "$ready"; return 1; }

	loop_drive() { drive run "$@"; }
	loop_events() { world_events "$@"; }
	# loop_prs <bead>...: how many open PRs carry a `Bead: <id>` trailer for one of these beads
	loop_prs() {
		(cd "$fixture" && gh pr list --state open --limit 50 --json number,body) | python3 -c '
import json, sys
ids = set(sys.argv[1:])
print(sum(1 for pr in json.load(sys.stdin)
          if ids & {l.strip()[6:] for l in pr["body"].splitlines() if l.strip().startswith("Bead: ")}))' "$@"
	}

	printf -- '--- claim tick\n'
	loop_drive --once || { printf 'FAIL loop: smile run --once exited %s\n' "$?"; return 1; }
	local b n
	for b in "$bead_a" "$bead_c"; do
		for n in bead.claimed worktree.acquired pane.spawned; do
			[ "$(loop_events "$b" "$n")" -eq 1 ] \
				|| { printf 'FAIL loop: %s has %s %s events, want 1\n' "$b" "$(loop_events "$b" "$n")" "$n"; return 1; }
		done
	done
	printf 'claimed, acquired, spawned once each for %s and %s\n' "$bead_a" "$bead_c"
	n=$( (ls "$fixture/.factory/runs"/*.json 2>/dev/null || true) | wc -l | tr -d ' ')
	[ "$n" -eq 2 ] || { printf 'FAIL loop: %s live run state files, want 2\n' "$n"; return 1; }
	ls "$fixture/.factory/runs"

	printf -- '--- waiting for the workers to open their pull requests\n'
	local i=0
	while [ "$i" -lt 40 ]; do
		n=$(loop_prs "$bead_a" "$bead_c" 2>/dev/null || printf '0\n')
		if [ "$n" -ge 2 ]; then break; fi
		sleep 5
		i=$((i + 1))
	done
	[ "$n" -ge 2 ] || { printf 'FAIL loop: %s open PRs carry a Bead trailer for A or C after %ss, want 2\n' "$n" "$((i * 5))"; loop_tail; return 1; }
	(cd "$fixture" && gh pr list --state open --json number,headRefName,body --jq '.[] | "#\(.number) \(.headRefName)"')

	printf -- '--- closing the beads (the review lane that does this lands in S4)\n'
	(cd "$fixture" && BD_NON_INTERACTIVE=1 bd close "$bead_a" "$bead_c" "$bead_b" >/dev/null 2>&1) || true

	printf -- '--- reap tick\n'
	loop_drive --once || { printf 'FAIL loop: the reap tick exited %s\n' "$?"; loop_tail; return 1; }
	for b in "$bead_a" "$bead_c"; do
		[ "$(loop_events "$b" pane.reaped)" -eq 1 ] \
			|| { printf 'FAIL loop: %s was not reaped\n' "$b"; loop_tail; return 1; }
	done
	n=$( (ls "$fixture/.factory/runs/done"/*.json 2>/dev/null || true) | wc -l | tr -d ' ')
	[ "$n" -eq 2 ] || { printf 'FAIL loop: %s run files under runs/done, want 2\n' "$n"; loop_tail; return 1; }
	grep -q '"event":"campaign.complete"' "$log" || { printf 'FAIL loop: no campaign.complete\n'; loop_tail; return 1; }
	[ ! -e "$fixture/.factory/driver.pid" ] || { printf 'FAIL loop: the pid file outlived the driver\n'; return 1; }
	loop_tail
	printf 'PASS loop\n'
}


# feature_review: the whole lane on one bead. The stub worker opens a pull request, the stub reviewer
# rejects it once, the worker fixes what the issue names, the second review approves, and the driver
# merges and closes the bead. Asserted against GitHub and the event log, never the driver's summary.
#
# --real-review runs the signed-in headless reviewer on the stub worker's trivial diff instead. It
# only has to produce a verdict with a non-empty detail; what it decides is its own business.
feature_review() {
	local runid="$1" fixture="$2" real="$3"
	local bead_a pr issues want got state
	[ "$(mf "$runid" install)" = "stamped" ] || { printf 'FAIL review: fixture not stamped (install=%s)\n' "$(mf "$runid" install)"; return 1; }
	[ -f "$fixture/smile/py/review.py" ] || { printf 'NOT IMPLEMENTED review (no smile/py/review.py stamped)\n'; exit 2; }

	"$fixture/smile/smile" init || { printf 'FAIL review: smile init exited %s\n' "$?"; return 1; }
	git -C "$fixture" add -A
	git -C "$fixture" diff --cached --quiet || git -C "$fixture" commit -qm "chore: smile init"

	if [ "$real" -eq 1 ]; then WORLD_CHANGES_ONCE=0; else WORLD_CHANGES_ONCE=1; fi
	world_up "$runid" "$fixture" || return 1
	# --real-review wants the signed-in claude, which is reached through its own wrapper: the rest of
	# the run keeps the scratch HOME, and only the reviewer steps back into the real one.
	if [ "$real" -eq 1 ]; then review_real_cmd || return 1; fi

	# bead A is the whole lane: the feature stops the moment its pane is reaped, and asserts nothing
	# about bead B, which bd unblocks only once A has closed.
	bead_a=$(mf "$runid" bead_a)
	printf 'bead %s, reviewer %s\n' "$bead_a" "${WORLD_REVIEW_CMD:-the real claude -p}"

	if [ "$real" -eq 1 ]; then
		review_real "$fixture" "$bead_a"
		return $?
	fi

	world_tick_until 600 "$fixture" review_landed "$bead_a" \
		|| { printf 'FAIL review: the lane did not land bead %s\n' "$bead_a"; review_dump "$fixture" "$bead_a"; return 1; }

	# the pull request merged, on GitHub, not in the log
	pr=$(world_pr "$bead_a" "$fixture")
	[ -n "$pr" ] || { printf 'FAIL review: no pull request carries a Bead trailer for %s\n' "$bead_a"; return 1; }
	state=$(cd "$fixture" && gh pr view "$pr" --json state --jq .state)
	printf 'pull request #%s is %s\n' "$pr" "$state"
	[ "$state" = "MERGED" ] || { printf 'FAIL review: PR #%s is %s, want MERGED\n' "$pr" "$state"; return 1; }

	# one review issue on this pull request, opened then closed
	issues=$(cd "$fixture" && gh issue list --label review --state all --limit 100 --json number,state,body)
	issues=$(printf '%s' "$issues" | python3 -c '
import json, sys
for i in sorted(json.load(sys.stdin), key=lambda i: i["number"]):
    if "PR: #" + sys.argv[1] in [l.strip() for l in i["body"].splitlines()]:
        print("#%s %s" % (i["number"], i["state"]))' "$pr")
	printf 'review issues naming PR #%s:\n%s\n' "$pr" "$issues"
	[ "$(printf '%s\n' "$issues" | grep -c 'CLOSED')" -eq 1 ] \
		|| { printf 'FAIL review: want exactly one CLOSED review issue on PR #%s\n' "$pr"; return 1; }
	[ "$(printf '%s\n' "$issues" | grep -c 'OPEN')" -eq 0 ] \
		|| { printf 'FAIL review: a review issue on PR #%s is still open\n' "$pr"; return 1; }
	(cd "$fixture" && gh pr view "$pr" --json comments --jq '.comments[].body') | grep -q '/issues/' \
		|| { printf 'FAIL review: the pull request carries no comment linking an issue\n'; return 1; }

	# the bead closed
	state=$(cd "$fixture" && BD_NON_INTERACTIVE=1 bd list --all --json | python3 -c '
import json, sys
print(next(b["status"] for b in json.load(sys.stdin) if b["id"] == sys.argv[1]))' "$bead_a")
	[ "$state" = "closed" ] || { printf 'FAIL review: bead %s is %s, want closed\n' "$bead_a" "$state"; return 1; }

	# the sequence of contract section 9, plus the fix round's own pane.spawned
	want="bead.claimed worktree.acquired pane.spawned pr.opened review.started issue.opened review.verdict pane.spawned review.started issue.resolved review.verdict pr.merged bead.closed pane.reaped"
	got=$(world_sequence "$bead_a")
	printf 'events for %s:\n  %s\n' "$bead_a" "$got"
	[ "$got" = "$want" ] || { printf 'FAIL review: the event sequence is not the contract'"'"'s\n  want: %s\n' "$want"; return 1; }
	printf 'PASS review\n'
}

# review_real_cmd: a wrapper running the signed-in `claude -p` under the real HOME, where its
# credentials live. Everything else in the run stays in the scratch world; the reviewer only reads.
# The argv is the lane's own default, read from the fixture's config.
review_real_cmd() {
	local model mode
	model=$(drive config get reviewer.models | cut -d, -f1)
	mode=$(drive config get worker.permission_mode)
	[ -n "$model" ] || { printf 'FAIL review: no reviewer.models in the config\n'; return 1; }
	cat > "$WORLD_HOME/real-reviewer" <<REALEOF
#!/bin/sh
export HOME="$HOME"
exec claude -p --model $model --permission-mode $mode
REALEOF
	chmod +x "$WORLD_HOME/real-reviewer"
	WORLD_REVIEW_CMD="$WORLD_HOME/real-reviewer"
	printf 'real reviewer: claude -p --model %s --permission-mode %s\n' "$model" "$mode"
}

# review_landed <bead>: the lane is done with that bead when its pane has been reaped
review_landed() { [ "$(world_events "$1" pane.reaped)" -ge 1 ]; }

# review_verdict <bead>: a verdict has been written for that bead
review_verdict() { [ "$(world_events "$1" review.verdict)" -ge 1 ]; }

review_dump() {
	printf -- '--- last events\n'
	tail -20 "$WORLD_LOG" 2>/dev/null || true
	printf -- '--- pull requests\n'
	(cd "$1" && gh pr list --state all --json number,state,headRefName) || true
	printf -- '--- issues\n'
	(cd "$1" && gh issue list --label review --state all --json number,state,title) || true
}

# review_real <fixture> <bead>: one bead through the signed-in headless reviewer. Minutes, not
# seconds, and the only assertion is that a verdict with a non-empty detail was written.
review_real() {
	local fixture="$1" bead="$2" detail
	world_tick_until 900 "$fixture" review_verdict "$bead" \
		|| { printf 'FAIL review: no verdict for %s\n' "$bead"; review_dump "$fixture"; return 1; }
	detail=$(python3 -c '
import json, sys
for o in map(json.loads, open(sys.argv[1])):
    if o["event"] == "review.verdict" and o["bead"] == sys.argv[2]:
        print(json.dumps({"detail": o["detail"], "sha": o["sha"], "pr": o["pr"]}))
        break' "$WORLD_LOG" "$bead")
	printf 'verdict: %s\n' "$detail"
	printf '%s' "$detail" | grep -q '"detail": *"[^"]' \
		|| { printf 'FAIL review: the verdict detail is empty\n'; return 1; }
	printf -- '--- the review the reviewer wrote\n'
	cat "$fixture"/.factory/reviews/*.md
	printf 'PASS review (real reviewer)\n'
}

# feature_gate: with the gate holding every approve, the driver labels the pull request and stops.
# A person merges it, and the next tick closes the bead.
feature_gate() {
	local runid="$1" fixture="$2"
	local bead_a pr labels state
	[ "$(mf "$runid" install)" = "stamped" ] || { printf 'FAIL gate: fixture not stamped (install=%s)\n' "$(mf "$runid" install)"; return 1; }
	[ -f "$fixture/smile/py/gate.py" ] || { printf 'NOT IMPLEMENTED gate (no smile/py/gate.py stamped)\n'; exit 2; }

	"$fixture/smile/smile" init || { printf 'FAIL gate: smile init exited %s\n' "$?"; return 1; }
	git -C "$fixture" add -A
	git -C "$fixture" diff --cached --quiet || git -C "$fixture" commit -qm "chore: smile init"
	world_up "$runid" "$fixture" || return 1

	bead_a=$(mf "$runid" bead_a)

	drive gate all || { printf 'FAIL gate: smile gate all exited %s\n' "$?"; return 1; }
	printf -- '--- gate status\n'
	drive gate status
	[ "$(drive gate status)" = "mode all" ] || { printf 'FAIL gate: status is not `mode all`\n'; return 1; }

	world_tick_until 600 "$fixture" review_verdict "$bead_a" \
		|| { printf 'FAIL gate: no verdict for %s\n' "$bead_a"; review_dump "$fixture"; return 1; }

	pr=$(world_pr "$bead_a" "$fixture")
	[ -n "$pr" ] || { printf 'FAIL gate: no pull request for %s\n' "$bead_a"; return 1; }
	printf -- '--- held pull request\n'
	(cd "$fixture" && gh pr view "$pr" --json number,state,labels)
	state=$(cd "$fixture" && gh pr view "$pr" --json state --jq .state)
	labels=$(cd "$fixture" && gh pr view "$pr" --json labels --jq '[.labels[].name] | join(",")')
	[ "$state" = "OPEN" ] || { printf 'FAIL gate: PR #%s is %s, want OPEN\n' "$pr" "$state"; return 1; }
	printf '%s' "$labels" | grep -q 'smile:approved' \
		|| { printf 'FAIL gate: PR #%s carries labels [%s], want smile:approved\n' "$pr" "$labels"; return 1; }
	[ "$(world_events "$bead_a" pr.merged)" -eq 0 ] || { printf 'FAIL gate: a held approve merged\n'; return 1; }

	printf -- '--- the human merges\n'
	(cd "$fixture" && gh pr merge "$pr" --squash) \
		|| { printf 'FAIL gate: manual merge exited %s\n' "$?"; return 1; }
	world_tick_until 300 "$fixture" gate_closed "$bead_a" \
		|| { printf 'FAIL gate: the bead did not close after the merge\n'; review_dump "$fixture"; return 1; }

	state=$(cd "$fixture" && BD_NON_INTERACTIVE=1 bd list --all --json | python3 -c '
import json, sys
print(next(b["status"] for b in json.load(sys.stdin) if b["id"] == sys.argv[1]))' "$bead_a")
	[ "$state" = "closed" ] || { printf 'FAIL gate: bead %s is %s, want closed\n' "$bead_a" "$state"; return 1; }
	printf 'events for %s:\n  %s\n' "$bead_a" "$(world_sequence "$bead_a")"
	printf 'PASS gate\n'
}

# gate_closed <bead>: the driver has recorded the human's merge and closed the bead
gate_closed() { [ "$(world_events "$1" bead.closed)" -ge 1 ]; }

loop_tail() { printf -- '--- last events\n'; tail -15 "$log"; }

# ---------------------------------------------------------------- down
# repo_disposed <owner/name>: true when the repo is gone, or renamed to -trash and archived.
# `gh repo view <old-name>` follows GitHub's rename redirect, so compare nameWithOwner instead of
# trusting the exit code.
repo_disposed() {
	local repo="$1" actual archived
	actual=$(gh repo view "$repo" --json nameWithOwner --jq .nameWithOwner 2>/dev/null || true)
	if [ -z "$actual" ]; then
		printf 'gone'
		return 0
	fi
	if [ "$actual" = "$repo-trash" ]; then
		archived=$(gh repo view "$repo-trash" --json isArchived --jq .isArchived 2>/dev/null || true)
		if [ "$archived" = "true" ]; then
			printf 'archived-renamed'
			return 0
		fi
	fi
	return 1
}

cmd_down() {
	local runid="${1:-}"
	[ -n "$runid" ] || die "usage: verify-smile down <runid>"
	require_manifest "$runid"
	local evidence="$EVIDENCE_ROOT/$runid"
	if [ "$(mf "$runid" state)" = "down" ]; then
		printf 'evidence kept at %s (already down)\n' "$evidence"
		return 0
	fi
	local fixture tmp session repo
	fixture=$(mf "$runid" fixture)
	tmp=$(mf "$runid" tmp)
	session=$(mf "$runid" tmux_session)
	repo=$(mf "$runid" repo)

	log "collecting evidence into $evidence"
	if [ -d "$fixture/.git" ]; then
		if [ -d "$fixture/.factory" ] && [ ! -e "$evidence/factory" ]; then
			cp -R "$fixture/.factory" "$evidence/factory"
		fi
		if [ ! -e "$evidence/prs.json" ]; then
			(cd "$fixture" && gh pr list --state all --json number,title,state,headRefName,mergedAt > "$evidence/prs.json.tmp" 2>/dev/null) \
				&& mv "$evidence/prs.json.tmp" "$evidence/prs.json" \
				|| { rm -f "$evidence/prs.json.tmp"; log "gh pr list failed; prs.json not written"; }
		fi
		if [ ! -e "$evidence/beads.json" ] && [ -d "$fixture/.beads" ]; then
			(cd "$fixture" && bd list --json > "$evidence/beads.json.tmp" 2>/dev/null) \
				&& mv "$evidence/beads.json.tmp" "$evidence/beads.json" \
				|| { rm -f "$evidence/beads.json.tmp"; log "bd list failed; beads.json not written"; }
		fi
	else
		log "no fixture clone at $fixture; nothing to collect"
	fi

	# an older loop feature linked the real home into the run's scratch home; never keep that
	[ ! -L "$evidence/home/Library" ] || rm -f "$evidence/home/Library"

	if [ -n "$session" ] && tmux has-session -t "=$session" 2>/dev/null; then
		log "killing tmux session $session"
		tmux kill-session -t "=$session"
	fi

	if [ -n "$tmp" ] && [ -d "$tmp" ]; then
		case "$tmp" in
			*/smile-verify.*) rm -rf "$tmp" ;;
			*) die "refusing to remove unexpected tmp path $tmp" ;;
		esac
	fi

	local disposal
	if disposal=$(repo_disposed "$repo"); then
		if [ "$disposal" = "gone" ]; then
			[ "$(mf "$runid" stage)" = "names" ] && disposal="never-created" || disposal="deleted"
		fi
		log "repo already disposed ($disposal)"
	elif gh repo delete "$repo" --yes >/dev/null 2>&1; then
		disposal="deleted"
	else
		log "gh repo delete failed (token lacks delete_repo?); renaming then archiving instead"
		# rename first: an archived repo is read-only and refuses the rename
		gh repo rename "$(basename "$repo")-trash" --repo "$repo" --yes >/dev/null 2>&1 || true
		gh repo archive "$repo-trash" --yes >/dev/null 2>&1 || true
		disposal="archived-renamed"
		printf 'verify-smile: run `gh auth refresh -h github.com -s delete_repo` to enable true deletion of fixture repos\n'
	fi
	repo_disposed "$repo" >/dev/null \
		|| die "repo $repo still exists and is not archived as -trash; run 'verify-smile down $runid' again"

	mf_set "$runid" state down disposal "$disposal"
	[ -d "$evidence" ] || die "evidence dir vanished: $evidence"
	printf 'evidence kept at %s\n' "$evidence"
}

# ---------------------------------------------------------------- list
cmd_list() {
	local r
	for r in $(each_run); do
		printf '%s\t%s\t%s\n' "$r" "$(mf "$r" state)" "$(mf "$r" repo)"
	done
}

# ---------------------------------------------------------------- gc
cmd_gc() {
	local dry=0
	[ "${1:-}" = "--dry-run" ] && dry=1
	local owner names count
	owner=$(gh api user --jq .login)
	names=$(gh repo list "$owner" --limit 500 --json name --jq '.[].name | select(startswith("smile-verify-") and endswith("-trash"))')
	count=$(printf '%s\n' "$names" | grep -c . || true)
	if [ "$count" -eq 0 ]; then
		printf 'no smile-verify-*-trash repos\n'
		return 0
	fi
	if [ "$dry" -eq 1 ]; then
		printf '%s\n' "$names"
		printf '%s trash repo(s); rerun without --dry-run to delete\n' "$count"
		return 0
	fi
	if gh api -i user 2>/dev/null | grep -i '^x-oauth-scopes:' | grep -q delete_repo; then
		local n
		for n in $names; do
			gh repo delete "$owner/$n" --yes >/dev/null 2>&1 && printf 'deleted %s\n' "$n" || printf 'failed %s\n' "$n"
		done
	else
		printf '%s trash repo(s) exist; the token lacks delete_repo\n' "$count"
		printf 'run `gh auth refresh -h github.com -s delete_repo` then `verify-smile gc`\n'
	fi
}

case "${1:-}" in
	up) shift; cmd_up "$@" ;;
	feature) shift; cmd_feature "$@" ;;
	down) shift; cmd_down "$@" ;;
	list) shift; cmd_list "$@" ;;
	gc) shift; cmd_gc "$@" ;;
	*) sed -n '2,8p' "$0"; exit 1 ;;
esac
