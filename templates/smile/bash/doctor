#!/usr/bin/env bash
# smile doctor: one line per prerequisite in a fixed order, exit 1 when any is missing.
# Read-only: never creates .factory/ or touches bd. Contract: docs/RUNTIME-CONTRACT.md section 4.
set -euo pipefail
. "$SMILE_ROOT/smile/bash/lib/config"
[ $# -eq 0 ] || { printf 'usage: smile doctor\n' >&2; exit 2; }
rc=0

on_path() { command -v "$1" >/dev/null 2>&1; }
check() {   # check <tool> [label]: "ok <label>" when <tool> is on PATH, else "missing <label> not on PATH"
	if on_path "$1"; then printf 'ok %s\n' "${2:-$1}"; else printf 'missing %s not on PATH\n' "${2:-$1}"; rc=1; fi
}

check git
check gh
if ! on_path gh; then printf 'missing gh-auth gh not on PATH\n'; rc=1
elif gh auth status >/dev/null 2>&1; then printf 'ok gh-auth\n'
else printf 'missing gh-auth gh auth status failed\n'; rc=1
fi
check claude
check bd
check treehouse

backend=$(config_get backend)
if [ -z "$backend" ]; then
	for b in tmux cmux herdr; do
		if on_path "$b"; then backend="$b"; break; fi
	done
fi
case "$backend" in
	'') printf 'missing mux none of tmux, cmux, herdr on PATH\n'; rc=1 ;;
	tmux|cmux|herdr) check "$backend" "mux $backend" ;;
	*) printf 'missing mux unknown backend %s\n' "$backend"; rc=1 ;;
esac
exit "$rc"
