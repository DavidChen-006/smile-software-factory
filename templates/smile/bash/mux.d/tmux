# mux.d/tmux: the tmux pane backend (docs/RUNTIME-CONTRACT.md section 7). Sourced by smile/bash/mux.
# Handle: tmux:<session>:<window_id>. The session part is the name tmux reports back, not the name
# asked for, because tmux rewrites `.` and `:` in a session name; the window part is tmux's own @N,
# stable for the life of the window and unique across sessions. Every -t target carries the `=`
# exact prefix, so a session whose name is a prefix of another is never hit by accident.

# tmux_clean_name <name>: the session name tmux will accept unchanged. tmux turns `.` and `:` into
# `_` itself, and a space would put a space in the handle, which the grammar forbids; doing the
# substitution here means the name asked for and the name tmux reports are the same string.
tmux_clean_name() { printf '%s' "${1//[[:space:].:]/_}"; }

# tmux_split_rest <rest>: set tmux_session_name and tmux_window_id from <session>:<window_id>.
# A session name holds no colon once cleaned, so the rest is exactly two colon-separated parts and
# the second is @<digits>. Anything else is a malformed handle, exit 2.
tmux_split_rest() {
	local rest="$1" digits
	case "$rest" in
		*:*:*) bad_handle "tmux:$rest" ;;
		*:*) ;;
		*) bad_handle "tmux:$rest" ;;
	esac
	tmux_session_name="${rest%:*}"
	tmux_window_id="${rest#*:}"
	[ -n "$tmux_session_name" ] || bad_handle "tmux:$rest"
	case "$tmux_window_id" in @*) digits="${tmux_window_id#@}" ;; *) bad_handle "tmux:$rest" ;; esac
	case "$digits" in ''|*[!0-9]*) bad_handle "tmux:$rest" ;; esac
}

# tmux_here: 1 when tmux is usable, else one stderr line and exit 1. alive and kill share it with
# spawn: a pane whose tool is gone cannot be reported dead or killed, and 0 is only ever for a
# pane that is known to be gone.
tmux_here() { command -v tmux >/dev/null 2>&1 || fail "missing tmux not on PATH"; }

# backend_spawn <name> <cwd> <command> [args...]: add a window to the session, creating the session
# the first time. Try new-window first and fall back on new-session rather than asking has-session,
# so two spawns racing into a fresh session cannot both decide to create it. The command is handed
# to tmux as argv after `--`, so tmux execs it directly and an argument with a space survives; a
# lone word would be one argument, which tmux runs through `sh -c`, so `env` makes it two.
backend_spawn() {
	local name="$1" cwd="$2" session out; shift 2
	tmux_here
	session=$(tmux_clean_name "$(mux_session)")
	if [ $# -eq 1 ]; then set -- env "$1"; fi
	out=$(tmux_new_window "$session" "$name" "$cwd" "$@") || out=""
	if [ -z "$out" ]; then
		out=$(tmux new-session -d -P -F '#{session_name}:#{window_id}' \
			-s "$session" -n "$name" -c "$cwd" -- "$@" 2>/dev/null) || out=""
		# lost the race to another spawn: the session exists now, so the window does fit
		[ -n "$out" ] || out=$(tmux_new_window "$session" "$name" "$cwd" "$@") || out=""
	fi
	[ -n "$out" ] || fail "tmux refused to open a window for $name"
	# The window must vanish when the command exits, so `alive` is the truth about the process.
	# Off is tmux's default; this overrides a user's global on. A command that already exited took
	# its window with it, which is the same end state, so a failure here is not an error.
	tmux set-window-option -t "=$out" remain-on-exit off >/dev/null 2>&1 || true
	printf 'tmux:%s\n' "$out"
}

tmux_new_window() {
	local session="$1" name="$2" cwd="$3"; shift 3
	tmux new-window -d -P -F '#{session_name}:#{window_id}' \
		-t "=$session" -n "$name" -c "$cwd" -- "$@" 2>/dev/null
}

# backend_alive <rest>: 0 while the window is listed in its session and its pane has not died.
# One tmux call answers both halves.
backend_alive() {
	tmux_split_rest "$1"
	tmux_here
	local out
	out=$(tmux list-windows -t "=$tmux_session_name" -F '#{window_id} #{pane_dead}' 2>/dev/null) || return 1
	grep -qxF "$tmux_window_id 0" <<<"$out"
}

# backend_kill <rest>: idempotent. A window that is already gone is the wanted end state.
backend_kill() {
	tmux_split_rest "$1"
	tmux_here
	tmux kill-window -t "=$tmux_session_name:$tmux_window_id" >/dev/null 2>&1 || true
}
