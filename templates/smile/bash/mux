#!/usr/bin/env bash
# smile mux: the seam the driver spawns and reaps panes through.
# Contract: docs/RUNTIME-CONTRACT.md section 7.
#
#   smile mux spawn <name> <cwd> <command> [args...]   prints <backend>:<rest>
#   smile mux alive <handle>                           0 alive, 1 not, 2 bad handle
#   smile mux kill  <handle>                           0 always, 2 bad handle
#
# The backend for spawn comes from config `backend`, else auto-detect tmux, cmux, herdr.
# The backend for alive and kill comes from the handle, so a pane outlives a config change.
# Each backend is one sourced file at smile/bash/mux.d/<backend> defining backend_spawn,
# backend_alive, and backend_kill. A backend with no file is `unknown backend <name>`, exit 2.
set -euo pipefail
. "$SMILE_ROOT/smile/bash/lib/config"

usage() { printf 'usage: smile mux spawn <name> <cwd> <command> [args...] | alive <handle> | kill <handle>\n' >&2; exit 2; }
fail()  { printf 'smile mux: %s\n' "$*" >&2; exit 1; }
bad_handle() { printf 'smile mux: malformed handle %s\n' "$1" >&2; exit 2; }

# mux_session: the session panes are grouped under; $SMILE_MUX_SESSION wins when non-empty.
# Used by the backends.
mux_session() {
	if [ -n "${SMILE_MUX_SESSION:-}" ]; then printf '%s' "$SMILE_MUX_SESSION"
	else printf 'smile-%s' "$(basename "$SMILE_ROOT")"; fi
}

# load_backend <name>: source its file, or exit 2. The name is checked against the three the
# contract allows before it is ever used as a path component, so a handle or a config value can
# never name a file outside mux.d/. The existence check then covers cmux and herdr until S8.
load_backend() {
	case "$1" in
		tmux|cmux|herdr) ;;
		*) printf 'smile mux: unknown backend %s\n' "$1" >&2; exit 2 ;;
	esac
	local file="$SMILE_ROOT/smile/bash/mux.d/$1"
	[ -f "$file" ] || { printf 'smile mux: unknown backend %s\n' "$1" >&2; exit 2; }
	. "$file"
}

# split_handle <handle>: set handle_backend and handle_rest, or exit 2.
# Grammar: <backend>:<rest>, one line, no whitespace, both parts non-empty.
split_handle() {
	local h="$1"
	case "$h" in
		*[[:space:]]*) bad_handle "$h" ;;
		*:*) ;;
		*) bad_handle "$h" ;;
	esac
	handle_backend="${h%%:*}"
	handle_rest="${h#*:}"
	[ -n "$handle_backend" ] && [ -n "$handle_rest" ] || bad_handle "$h"
}

verb="${1:-}"; shift || true
case "$verb" in
	spawn)
		[ $# -ge 3 ] || usage
		backend=$(config_get backend)
		if [ -z "$backend" ]; then
			for b in tmux cmux herdr; do
				if command -v "$b" >/dev/null 2>&1; then backend="$b"; break; fi
			done
		fi
		[ -n "$backend" ] || fail "missing backend, none of tmux, cmux, herdr on PATH"
		load_backend "$backend"
		[ -d "$2" ] || fail "no such directory $2"
		backend_spawn "$@"
		;;
	alive)
		[ $# -eq 1 ] || usage
		split_handle "$1"
		load_backend "$handle_backend"
		backend_alive "$handle_rest"
		;;
	kill)
		[ $# -eq 1 ] || usage
		split_handle "$1"
		load_backend "$handle_backend"
		backend_kill "$handle_rest"
		exit 0
		;;
	*) usage ;;
esac
